diff --git a/chrome/android/java/src/org/chromium/chrome/browser/privacy/settings/SensitiveActivityReauthenticator.java b/chrome/android/java/src/org/chromium/chrome/browser/privacy/settings/SensitiveActivityReauthenticator.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/privacy/settings/SensitiveActivityReauthenticator.java
@@ -0,0 +1,54 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.privacy.settings;
+
+import android.app.Activity;
+import android.view.WindowManager;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.device_reauth.BiometricStatus;
+import org.chromium.chrome.browser.device_reauth.DeviceAuthSource;
+import org.chromium.chrome.browser.device_reauth.ReauthenticatorBridge;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.profiles.Profile;
+
+/** Gates creation of sensitive standalone browser UIs behind the device screen lock. */
+@NullMarked
+public final class SensitiveActivityReauthenticator {
+    public static final String PREF_LOCK_BOOKMARKS = "privacy_lock_bookmarks";
+    public static final String PREF_LOCK_DOWNLOADS = "privacy_lock_downloads";
+
+    private SensitiveActivityReauthenticator() {}
+
+    public static void authenticate(
+            Activity activity,
+            Profile profile,
+            String preferenceKey,
+            @DeviceAuthSource int source,
+            Runnable onSuccess) {
+        if (!ChromeSharedPreferences.getInstance().readBoolean(preferenceKey, false)) {
+            onSuccess.run();
+            return;
+        }
+
+        activity.getWindow().addFlags(WindowManager.LayoutParams.FLAG_SECURE);
+        ReauthenticatorBridge bridge = ReauthenticatorBridge.create(activity, profile, source);
+        if (bridge.getBiometricAvailabilityStatus() == BiometricStatus.UNAVAILABLE) {
+            bridge.destroy();
+            activity.finish();
+            return;
+        }
+
+        bridge.reauthenticate(
+                success -> {
+                    bridge.destroy();
+                    if (success && !activity.isFinishing() && !activity.isDestroyed()) {
+                        onSuccess.run();
+                    } else {
+                        activity.finish();
+                    }
+                });
+    }
+}
